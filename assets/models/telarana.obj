# Media telarana de 1.5 x 1 m que cuelga del origen (centro del borde de arriba).
# Blender 5.2.2 LTS
# www.blender.org
mtllib telarana.mtl
o telarana
v -0.750000 -1.000000 0.000000
v 0.750000 -1.000000 0.000000
v 0.750000 0.000000 0.000000
v -0.750000 0.000000 0.000000
v -0.750000 0.000000 -0.003000
v 0.750000 0.000000 -0.003000
v 0.750000 -1.000000 -0.003000
v -0.750000 -1.000000 -0.003000
vn -0.0000 -0.0000 1.0000
vn -0.0000 -0.0000 -1.0000
vt 1.000000 0.000000
vt 0.000000 1.000000
vt 0.000000 0.000000
vt 1.000000 1.000000
s 0
usemtl spr_telarana
f 2/1/1 4/2/1 1/3/1
f 6/4/2 8/3/2 5/2/2
f 2/1/1 3/4/1 4/2/1
f 6/4/2 7/1/2 8/3/2
