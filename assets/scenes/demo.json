        { "play_sound": "audio/puerta_cerrada.wav", "volume": 0.8 },
        { "message": "La puerta esta cerrada.\nNecesitas la llave y 3 monedas.\nMonedas: {monedas}/3" }
      ]
    },
    {
      "name": "puerta_noche",
      "position": [9, 0, -6],
      "size": [2, 2.4, 0.8],
      "marker": true,
      "color": [140, 120, 255, 255],
